class Solution {
  public:
    string firstNonRepeating(string &s) {
        queue<char>q;
        
        string ans;
        
        vector<int> freq(26,0);
        
        for(int i=0; i<s.size(); i++){
            freq[s[i]-'a']++;
            
            if(freq[s[i]-'a']==1){
                q.push(s[i]);
            }
            
            while(!q.empty() && freq[q.front()-'a']>1){
                q.pop();
            }
            
            if(q.empty()) ans+="#";
            else ans+= q.front();
        }
        
        return ans;
    }
};
