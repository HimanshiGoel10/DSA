class Solution {
public:
    int minimumPushes(string word) {
        int n = word.size();

        int ans = 0;

        int num = 1;
        int cnt = 0;

        for(int i=0; i<n; i++){
            ans += num;
            cnt++;

            if(cnt==8){
                num++;
                cnt=0;
            }
        }

        return ans;
    }
};
