class Solution {
public:
    bool check (int n, int t){
        int product = 1;
        while(n){
            product *= n%10;
            n = n/10;
        }
        return product%t==0;
    }
    int smallestNumber(int n, int t) {
        while(1){
            if(check(n,t)) return n;
            n++;
        }
        return -1; // dummy return 
    }
};
