class Solution {
public:
    int product (int n){
        int pro = 1;

        while(n){
            pro *= (n%10);
            n /= 10;
        }

        return pro;
    }

    int sum (int n){
        int s = 0;

        while(n){
            s += (n%10);
            n /= 10;
        }

        return s;
    }

    bool checkDivisibility(int n) {
        return !(n%(product(n)+sum(n))) ;
    }
};
