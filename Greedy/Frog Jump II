class Solution {
public:
    int maxJump(vector<int>& stones) {
        int ans = stones[1];

        int n = stones.size();

        for(int i=3; i<=n-1; i+=2){
            ans = max(ans, stones[i]-stones[i-2]);
        }

        for(int i=2; i<=n-1; i+=2){
            ans = max(ans, stones[i]-stones[i-2]);
        }

        return ans;
    }
};
