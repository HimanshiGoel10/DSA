class Solution {
  public:
    bool static cmp (vector<int> &a, vector<int> &b){
        if(a[2]==b[2]){
            return a[1]<b[1];
        }
        return a[2]<b[2];
    }
    int maxStop(int m, vector<vector<int>> &trains) {
        sort(begin(trains), end(trains), cmp);
        
        int cnt = 0;
        
        int currPlatform = -1;
        int endTime = -1;
        
        for(int i=0; i<trains.size(); i++){
            if(currPlatform != trains[i][2] || endTime <= trains[i][0]){
                cnt++;
                currPlatform = trains[i][2];
                endTime = trains[i][1];
            }
        }
        
        return cnt;
    }
};
