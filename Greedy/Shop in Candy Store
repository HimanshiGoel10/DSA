class Solution {
  public:
    vector<int> minMaxCandy(vector<int>& prices, int k) {
        
        int n = prices.size();
        int i=0;
        int j = n-1;
        
        int minCost = 0;
        int maxCost = 0;
        
        sort(begin(prices),end(prices));
        
        // min cost
        
        while(i<=j){
            minCost += prices[i];
            i++;
            
            for(int l=0; l<k; l++) j--;
        }
        
        // maxCost
        
        i=0;
        j=n-1;
        
        while(i<=j){
            maxCost += prices[j];
            j--;
            
            for(int l=0; l<k; l++) i++;
        }
        
        return {minCost,maxCost};
    }
};
