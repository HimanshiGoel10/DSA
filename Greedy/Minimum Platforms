class Solution {
  public:
    typedef pair<int,int> p;
    
    int minPlatform(vector<int>& arr, vector<int>& dep) {
        
        int n = arr.size();
        
        priority_queue <int, vector<int>, greater<int>> pq;
        
        vector<p> trains;
        
        for(int i=0; i<n; i++){
            trains.push_back({arr[i], dep[i]});
        }
        
        sort(begin(trains), end(trains));
        
        int ans = 0;
        
        for(int i=0; i<n; i++){
            
            if(!pq.empty() && pq.top()<trains[i].first){
                pq.pop();
            }
            
            pq.push(trains[i].second);
            
            if(pq.size()> ans) ans = pq.size();
        }
        
        return ans;
    }
};
