class Solution {
  public:
    bool canRearrange(string& s) {
        vector<int> freq(26,0);
        
        int n = s.size();
        
        int maxFreq = 0;
        
        for(auto &ch: s){
            freq[ch-'a']++;
            maxFreq = max(maxFreq, freq[ch-'a']);
        }
        
        if(maxFreq>(n+1)/2) return false;
        
        return true;
    }
};
