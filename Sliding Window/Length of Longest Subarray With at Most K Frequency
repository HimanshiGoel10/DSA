class Solution {
public:
    int maxSubarrayLength(vector<int>& nums, int k) {
        unordered_map <int,int> freq;

        int i=0;
        int j=0;

        int n = nums.size();

        int maxLen = 0;

        while(j<n){
            freq[nums[j]]++;

            while(freq[nums[j]]>k){
                freq[nums[i]]--;
                i++;
            }

            j++;
            maxLen = max(maxLen, j-i);
        }

        return maxLen;
    }
};
