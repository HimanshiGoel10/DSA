class Solution {
  public:
    int minSwap(vector<int>& arr, int k) {
        int i = 0;
        int j = 0;
        
        int n = arr.size();
        
        int total = 0;
        
        for(auto &num: arr){
            if(num<=k) total++;
        }
        
        int cnt = 0;
        
        while(j<total){
            if(arr[j]<=k) cnt++;
            j++;
        }
        
        int ans = total-cnt;
        
        while(j<=n){
            ans = min(ans, total-cnt);
            
            if(arr[i]<=k) cnt--;
            i++;
            
            if(j<n && arr[j]<=k) cnt++;
            j++;
        }
        
        return ans;
    }
};
