class Solution {
  public:
    void pushZerosToEnd(vector<int>& arr) {
        int i = 0;
        int j = 0;
        
        int n = arr.size();
        
        for(int i=0; i<n; i++){
            if(arr[i]!=0){
                arr[j] = arr[i];
                j++;
            }
        }
        
        while(j<n){
            arr[j] = 0;
            j++;
        }
    }
};
