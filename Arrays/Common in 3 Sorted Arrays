class Solution {
  public:
    vector<int> commonElements(vector<int> &a, vector<int> &b, vector<int> &c) {
        int i = 0;
        int j = 0;
        int k = 0;
        
        vector<int> ans;
        
        while(i<a.size() && j<b.size() && k<c.size()){
            
            while(i>0 && i<a.size() && a[i]==a[i-1])i++;
            while(j>0 && j<b.size() && b[j]==b[j-1])j++;
            while(k>0 && k<c.size() && c[k]==c[k-1])k++;
            
            if(i==a.size() || j==b.size() || k==c.size()) break;
            
            if(a[i]==b[j] && b[j]==c[k]){
                ans.push_back(a[i]);
                i++;
                j++;
                k++;
                continue;
            }
            
            // move the smallest
            
            if(a[i]<= b[j] && a[i]<=c[k]) i++;
            else if(a[i]>= b[j] && b[j]<=c[k]) j++;
            else k++;
        }
        
        return ans;
    }
};
