class Solution {
  public:
    int maxWater(vector<int> &arr) {
        int n = arr.size();
        
        vector<int> prefix (n,0); 
        vector<int> suffix (n,0); 
        
        int currMax = 0;
        
        for(int i=0; i<n; i++){
            currMax = max(currMax, arr[i]);
            
            prefix[i] = currMax - arr[i];
        }
        
        currMax = 0;
        
        for(int i=n-1; i>=0; i--){
            currMax = max(currMax, arr[i]);
            
            suffix[i] = currMax - arr[i];
        }
        
        int water = 0;
        
        for(int i=0; i<n; i++){
            water += min(prefix[i], suffix[i]);
        }
        
        return water;
    }
};
