class Solution {
  public:
    int maxWater(vector<int> &arr) {
        int n = arr.size();
        
        int i = 0;
        int j = n-1;
        
        int leftMax = 0;
        int rightMax = 0;
        
        int water = 0;
        
        while(i<j){
            
            if(arr[i]<=arr[j]){
                leftMax = max(leftMax, arr[i]);
                water += leftMax-arr[i];
                i++;
            }
            
            else{
                rightMax = max(rightMax, arr[j]);
                water += rightMax-arr[j];
                j--;
            }
        }
        
        return water;
    }
};
