class Solution {
  public:
    int findMinDiff(vector<int>& a, int m) {
        int n = a.size();
        
        int i = 0;
        int j = m-1;
        
        int ans = 1e9;
        
        sort(begin(a), end(a));
        
        while(j<n){
            ans = min(ans, a[j]-a[i]);
            i++; j++;
        }
        
        return ans;
    }
};
