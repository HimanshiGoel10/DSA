class Solution {
public:
    int minimumPushes(string word) {
        vector<int> freq (26,0);

        for(auto &ch: word){
            freq[ch-'a']++;
        }

        sort(rbegin(freq),rend(freq));

        int num = 1;
        int cnt = 0;

        int ans = 0;

        for(int i=0; i<26; i++){
            ans += (freq[i]*num);
            cnt++;

            if(cnt==8){
                num++;
                cnt=0;
            }
        }

        return ans;
    }
};
