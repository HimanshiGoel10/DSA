class Solution {
  public:
    typedef pair<int,int> p;
    
    bool check (unordered_map <int,vector<int>> &adj, vector<bool> &visited, int u) {
        queue <p> q; // {node, parent}
        
        q.push({u,-1});
        visited[u] = true;
        
        while(!q.empty()){
            auto front = q.front();
            q.pop();
            
            int node = front.first;
            int parent = front.second;
            
            for(auto &v: adj[node]){
                if(visited[v]){
                    if(parent!=v) return true;
                    continue;
                }
                visited[v] = true;
                q.push({v,node});
            }
        }
        
        return false;
    }
    
    bool isCycle(int V, vector<vector<int>>& edges) {
        
        unordered_map <int,vector<int>> adj;
        
        for(auto &edge: edges){
            adj[edge[0]].push_back(edge[1]);
            adj[edge[1]].push_back(edge[0]);
        }
        
        vector<bool> visited (V, false);
        
        for(int i=0; i<V; i++){
            if(!visited[i] && check(adj, visited, i)) return true;
        }
        
        return false;
        
    }
};
