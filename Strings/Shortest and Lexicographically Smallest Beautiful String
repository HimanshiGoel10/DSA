class Solution {
public:
    string shortestBeautifulSubstring(string s, int k) {
        string ans = "";

        for(int i=0; i<s.size(); i++){
            string curr;
            int cnt = 0;
            for(int j=i; j<s.size(); j++){
                if(s[j]=='1') cnt++;

                curr+= s[j];

                if (cnt == k) {
                    if (ans.empty() ||
                        curr.size() < ans.size() ||
                        (curr.size() == ans.size() && curr < ans)) {
                        ans = curr;
                    }

                    break;
                }
            }
        }

        return ans;
    }
};
