class Solution {
public:
    string countAndSay(int num) {
        if(num==1) return "1";

        string prev = countAndSay(num-1);

        int i = 0;
        int n = prev.size();

        string ans;

        while(i<n){

            int cnt = 1;

            int j = i+1;
            
            for(j=i+1; j<n; j++){
                if(prev[j]!=prev[j-1]) break;
                cnt++;
            }

            ans+= to_string(cnt);
            ans+= prev[i];

            i=j;
        }

        return ans;
    }
};
