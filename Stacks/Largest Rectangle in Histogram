class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        int n = heights.size();

        vector<int> leftWidth(n,1);
        vector<int> rightWidth(n,1);

        stack<int> st;

        for(int i=n-1; i>=0; i--){
            while(!st.empty() && heights[st.top()]>=heights[i]){
                leftWidth[i] += leftWidth[st.top()];
                st.pop();
            }
            st.push(i);
        }

        while(!st.empty()) st.pop();

        for(int i=0; i<n; i++){
            while(!st.empty() && heights[st.top()]>=heights[i]){
                rightWidth[i] += rightWidth[st.top()];
                st.pop();
            }
            st.push(i);
        }

        int maxArea = 0;

        for(int i=0; i<n; i++){
            maxArea = max(maxArea, (leftWidth[i]+rightWidth[i]-1)*heights[i]);
        }
        return maxArea;
    }
};
