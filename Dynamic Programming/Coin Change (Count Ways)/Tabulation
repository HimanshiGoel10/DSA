class Solution {
  public:
    int count(vector<int>& coins, int sum) {
        int n = coins.size();
        vector<vector<int>> dp (n+1, vector<int>(sum+1, 0));
        
        for(int i=0; i<=n; i++) dp[i][sum] = 1;
        
        for(int i=n-1; i>=0; i--){
            for(int j=sum-1; j>=0; j--){
                dp[i][j] += dp[i+1][j];
                
                if(coins[i]+j <= sum){
                    dp[i][j] += dp[i][j+coins[i]];
                }
            }
        }
        
        return dp[0][0];
    }
};
