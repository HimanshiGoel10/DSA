class Solution {
  public:
    bool isSubsetSum(vector<int>& arr, int sum) {
        int n = arr.size();
        vector <vector<bool>> dp (n+1, vector<bool>(sum+1,false));
        
        for(int i=0; i<=n; i++){
            dp[i][0] = true;
        }
        
        for(int i=n-1; i>=0; i--){
            for(int j=1; j<=sum; j++){
                dp[i][j] = dp[i+1][j];
                if(j-arr[i]>=0) dp[i][j] = dp[i][j] || dp[i+1][j-arr[i]];
            }
        }
        
        return dp[0][sum];
    }
};
