class Solution {
public:
    int dp[1001][1002];
    int solve (vector<vector<int>>& pairs, int idx, int lastIdx){
        if(idx>=pairs.size()){
            return 0;
        }

        if(dp[idx][lastIdx]!=-1) return dp[idx][lastIdx];

        int take = 0;

        if(lastIdx==1001 || pairs[lastIdx][1] < pairs[idx][0]){
            take = 1+solve(pairs,idx+1,idx);
        }

        int notTake = solve(pairs,idx+1,lastIdx);

        return dp[idx][lastIdx] = max(take,notTake);
    }
    int findLongestChain(vector<vector<int>>& pairs) {
        memset(dp,-1,sizeof(dp));
        sort(begin(pairs), end(pairs));
        return solve (pairs, 0, 1001);
    }
};
