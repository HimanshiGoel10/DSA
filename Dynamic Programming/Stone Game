class Solution {
public:
    int dp[501][501][2];
    int solve (vector<int>& piles, int si, int ei, bool aliceTurn){
        if(si>ei){
            return 0;
        }

        if(dp[si][ei][aliceTurn]!=-1) return dp[si][ei][aliceTurn];

        int a = 0;
        int b = 0;

        if(aliceTurn){
            a = piles[si]+solve(piles,si+1,ei,!aliceTurn);
            b = piles[ei]+solve(piles,si,ei-1,!aliceTurn);

            return dp[si][ei][aliceTurn] = max(a,b);
        }

        a = solve(piles,si+1,ei,!aliceTurn);
        b = solve(piles,si,ei-1,!aliceTurn);

        return dp[si][ei][aliceTurn] = min(a,b);

    }
    bool stoneGame(vector<int>& piles) {
        int n = piles.size();
        int total = accumulate(begin(piles), end(piles),0);

        memset(dp,-1,sizeof(dp));

        int aliceScore = solve (piles,0,n-1,true);  

        return aliceScore>total-aliceScore;
    }
};
