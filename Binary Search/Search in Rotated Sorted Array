class Solution {
  public:
    int binarySearch (vector<int>& arr, int si, int ei, int key){
        
        int ans = -1;
        
        while(si<=ei){
            int mid = si + (ei-si)/2;
            
            if(arr[mid]==key){
                return mid;
            }
            
            if(arr[si]<=arr[mid]){
                if(key>= arr[si] && key <=arr[mid]){
                    ei = mid-1;
                }
                else si = mid+1;
            }
            
            else{
                if(key>=arr[mid] && key<=arr[ei]){
                    si = mid+1;
                }
                else ei = mid-1;
            }
            
        }
        
        return ans;
    }
    int search(vector<int>& arr, int key) {
        int n = arr.size();
        
        return binarySearch(arr,0,n-1,key);
    }
};
